PORT=5000
NODE_ENV=development
# Keep true for the judge/demo wallet flow; set false in production.
DEMO_MODE=true
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-16-character-secret
ADMIN_USERNAME=Marketplace Admin
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=<marketplace-address>
MARKETPLACE_CONTRACT_ADDRESS=<marketplace-address>
NEURAL_TOKEN_ADDRESS=<neural-token-address>
PINATA_JWT=<pinata-jwt-for-real-ipfs>
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?appName=NeuralChainDB